# ============================================================
# MarketLens v3 — Web Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ── Database (Neon Serverless Postgres) ──────────────────────
# Get both from: https://console.neon.tech → Project → Connection Details
# Use POOLED connection string for DATABASE_URL, DIRECT for DIRECT_URL
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ── NextAuth ─────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-char-secret-here"

# ── OAuth (optional — remove to disable Google login) ────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Stripe ───────────────────────────────────────────────────
# Keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook: https://dashboard.stripe.com/test/webhooks (or stripe listen)
STRIPE_WEBHOOK_SECRET="whsec_..."
# Create prices in Stripe dashboard, paste IDs:
STRIPE_PRICE_ID_PRO_MONTHLY="price_..."
STRIPE_PRICE_ID_PRO_YEARLY="price_..."
STRIPE_PRICE_ID_ENTERPRISE_MONTHLY="price_..."

# ── Email (Resend) ────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# ── ETL Microservice (FastAPI) ────────────────────────────────
ETL_SERVICE_URL="http://localhost:8000"
# Must match API_KEY in api/.env
ETL_SERVICE_API_KEY="dev-etl-key"

# ── Market Data Provider ──────────────────────────────────────
# MOCK = no API key needed (default)
# ALPHA_VANTAGE = https://www.alphavantage.co/support/#api-key
# FMP = https://financialmodelingprep.com/developer/docs
MARKET_DATA_PROVIDER="MOCK"
ALPHA_VANTAGE_API_KEY=""
FMP_API_KEY=""

# ── AI Analyst ────────────────────────────────────────────────
# OpenRouter (200+ models — Claude, GPT-4o, Gemini, Llama, etc.)
# Get key: https://openrouter.ai/keys
# One key gives access to all models. Cheapest option.
OPENROUTER_API_KEY=""

# Direct Anthropic API (fallback / alternative to OpenRouter)
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=""
